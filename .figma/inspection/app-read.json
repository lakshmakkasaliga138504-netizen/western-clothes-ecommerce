ap-3 p-3 border border-gray-300 cursor-pointer hover:bg-gray-50\">\n314:                           <input type=\"radio\" name=\"payment\" className=\"mt-0.5\" defaultChecked={pm.id === \"cod\"} />\n315:                           <div>\n316:                             <p className=\"text-xs font-semibold text-gray-800\">{pm.label}</p>\n317:                             <p className=\"text-xs text-gray-500\">{pm.desc}</p>\n318:                           </div>\n319:                         </label>\n320:                       ))}\n321:                     </div>\n322:                   </div>\n323:                 </div>\n324:                 <div className=\"w-64 flex-shrink-0\">\n325:                   <div className=\"border border-gray-300 p-4 space-y-3\">\n326:                     <h3 className=\"text-sm font-bold text-gray-800 border-b border-gray-200 pb-2\">3. Order Summary</h3>\n327:                     {[\n328:                       { name: \"Floral Midi Dress × 1\", price: \"₹ 1,499\" },\n329:                       { name: \"Denim Jacket × 2\", price: \"₹ 4,398\" },\n330:                       { name: \"Boho Top × 1\", price: \"₹ 799\" },\n331:                     ].map((it) => (\n332:                       <div key={it.name} className=\"flex justify-between text-xs text-gray-700\">\n333:                         <span>{it.name}</span>\n334:                         <span className=\"font-medium\">{it.price}</span>\n335:                       </div>\n336:                     ))}\n337:                     <div className=\"border-t border-gray-200 pt-2 space-y-1\">\n338:                       <SummaryRow label=\"Subtotal\" value=\"₹ 6,696\" />\n339:                       <SummaryRow label=\"Shipping\" value=\"FREE\" />\n340:                       <SummaryRow label=\"Discount\" value=\"− ₹ 500\" />\n341:                       <div className=\"border-t border-gray-300 pt-2\">\n342:                         <SummaryRow label=\"Grand Total\" value=\"₹ 6,196\" bold />