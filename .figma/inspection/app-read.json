<div key={i} className={`w-7 h-7 rounded-full border-2 border-gray-400 ${c}`} />\n201:                       ))}\n202:                     </div>\n203:                   </div>\n204:                   <div>\n205:                     <label className=\"text-xs font-semibold text-gray-700 uppercase tracking-wide block mb-1\">Quantity</label>\n206:                     <div className=\"flex items-center\">\n207:                       <button className=\"border border-gray-400 text-gray-700 w-8 h-8 text-base\">−</button>\n208:                       <div className=\"border-t border-b border-gray-400 w-10 h-8 flex items-center justify-center text-xs text-gray-700\">1</div>\n209:                       <button className=\"border border-gray-400 text-gray-700 w-8 h-8 text-base\">+</button>\n210:                     </div>\n211:                   </div>\n212:                   <div className=\"flex gap-3 pt-2\">\n213:                     <button className=\"flex-1 bg-gray-800 text-white text-xs py-2.5 border border-gray-800 hover:bg-gray-700 font-medium tracking-wide uppercase\">\n214:                       Add to Cart\n215:                     </button>\n216:                     <button className=\"flex-1 border border-gray-800 text-gray-800 text-xs py-2.5 hover:bg-gray-100 font-medium tracking-wide uppercase\">\n217:                       Buy Now\n218:                     </button>\n219:                   </div>\n220:                 </div>\n221:               </div>\n222:             </div>\n223:           </Screen>\n224: \n225:           {/* ── SCREEN 5: SHOPPING CART PAGE ─────────────────────────── */}\n226:           <Screen number={5} title=\"SHOPPING CART PAGE\">\n227:             <NavBar />\n228:             <div className=\"px-6 py-4\">\n229:               <h2 className=\"text-base font-bold text-gray-800 mb-4\">\n230:                 Shopping Cart <span className=\"text-sm font-normal text-gray-500\">(3 items)</span>\n231:               </h2>\n232:               <d