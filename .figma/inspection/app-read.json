Jackets\", \"Skirts\", \"Shorts\"].map((i) => (\n105:                       <FilterItem key={i} label={i} />\n106:                     ))}\n107:                   </FilterGroup>\n108:                   <FilterGroup title=\"Price Range\">\n109:                     <div className=\"space-y-1 mb-1\">\n110:                       <div className=\"text-xs text-gray-500\">₹ 0 — ₹ 5,000</div>\n111:                       <div className=\"h-1.5 bg-gray-200 rounded relative\">\n112:                         <div className=\"absolute left-1/4 right-1/4 h-full bg-gray-600 rounded\" />\n113:                       </div>\n114:                     </div>\n115:                     {[\"Under ₹500\", \"₹500–₹1000\", \"₹1000–₹2000\", \"Above ₹2000\"].map((i) => (\n116:                       <FilterItem key={i} label={i} />\n117:                     ))}\n118:                   </FilterGroup>\n119:                   <FilterGroup title=\"Size\">\n120:                     <div className=\"flex flex-wrap gap-1 mt-1\">\n121:                       {[\"XS\", \"S\", \"M\", \"L\", \"XL\", \"XXL\"].map((s) => (\n122:                         <span key={s} className=\"border border-gray-400 text-xs px-2 py-0.5 text-gray-700\">{s}</span>\n123:                       ))}\n124:                     </div>\n125:                   </FilterGroup>\n126:                   <FilterGroup title=\"Color\">\n127:                     <div className=\"flex flex-wrap gap-1.5 mt-1\">\n128:                       {[\"Black\", \"White\", \"Grey\", \"Navy\", \"Brown\", \"Beige\"].map((c) => (\n129:                         <span key={c} className=\"text-xs text-gray-600 border border-gray-300 px-1.5 py-0.5\">{c}</span>\n130:                       ))}\n131:                     </div>\n132:                   </FilterGroup>\n133:                   <button className=\"w-full border border-gray-400 text-xs py-1.5 text-gray-600 mt-1\">\n134:                     Clear Filters\n135:                   </button>\n136:                